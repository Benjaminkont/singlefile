{
  "name": "local-singlefile-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-source offline webpage library powered by SingleFile",
  "scripts": {
    "single-file": "node scripts/single-file.mjs",
    "capture": "node scripts/capture-all.mjs",
    "prepare": "node scripts/prepare-preview.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "node scripts/preview.mjs",
    "add": "node scripts/add-page.mjs",
    "relink": "node scripts/relink.mjs",
    "discover": "python3 scripts/discover-urls.py",
    "capture:all": "node scripts/capture-all.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "puppeteer": "25.12.0",
    "single-file-cli": "2.16.1"
  }
}
